/* 全局样式 - 清迈活动指南小程序 */

page {
  --brand-color: #FF6B35;
  --brand-light: #FF8F65;
  --brand-bg: #FFF3ED;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  background: #F5F5F5;
  -webkit-font-smoothing: antialiased;
}

/* 去除按钮默认样式 */
button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
}

button::after {
  border: none;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 安全区域适配 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
