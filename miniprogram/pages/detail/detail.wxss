.container {
  padding-bottom: 140rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, var(--brand-color, #FF6B35), var(--brand-light, #FF8F65));
  padding: 40rpx 30rpx;
  color: #fff;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 20rpx;
}

.status {
  font-size: 24rpx;
}

.status.active {
  color: #B7F7B7;
}

.status.inactive {
  color: rgba(255,255,255,0.6);
}

.status.suspended {
  color: #FFD666;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

/* 暂停提示 */
.suspension-banner {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 20rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #FFF7E6;
  border-left: 6rpx solid #FAAD14;
  border-radius: 12rpx;
}

.suspension-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.suspension-text {
  font-size: 26rpx;
  color: #AD6800;
  line-height: 1.5;
}

/* 信息区块 */
.info-section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.info-item {
  display: flex;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  word-break: break-all;
}

.info-value.link {
  color: var(--brand-color, #FF6B35);
}

.info-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.info-hint {
  font-size: 22rpx;
  color: var(--brand-color, #FF6B35);
  opacity: 0.7;
}

/* 来源链接 */
.source-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.source-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.source-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.source-label {
  font-size: 24rpx;
  color: #999;
}

.source-url {
  font-size: 26rpx;
  color: var(--brand-color, #FF6B35);
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.source-hint {
  font-size: 22rpx;
  color: var(--brand-color, #FF6B35);
  opacity: 0.7;
}

/* 描述（格式化） */
.desc-section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.desc-line {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.desc-line:last-child {
  margin-bottom: 0;
}

.desc-line.highlight {
  background: #FAFAFA;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-left: -16rpx;
  margin-right: -16rpx;
}

.desc-icon {
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  flex: 1;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.action-btn {
  flex: 1;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  padding: 0;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: var(--brand-color, #FF6B35);
  color: #fff;
}

.action-btn.secondary {
  background: #F5F5F5;
  color: #333;
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top: 4rpx solid var(--brand-color, #FF6B35);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
