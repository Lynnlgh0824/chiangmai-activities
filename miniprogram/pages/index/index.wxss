.container {
  padding-bottom: 20rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 24rpx;
  background: var(--brand-color, #FF6B35);
}

.search-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  background: rgba(255,255,255,0.9);
  border-radius: 40rpx;
  padding: 16rpx 60rpx 16rpx 30rpx;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  position: absolute;
  right: 20rpx;
  font-size: 28rpx;
  color: #999;
  padding: 10rpx;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.category-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  transition: all 0.2s;
}

.category-tag.active {
  background: var(--brand-color, #FF6B35);
  color: #fff;
}

/* 筛选工具栏 */
.filter-toolbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  gap: 20rpx;
}

.filter-toggle {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  position: relative;
}

.filter-icon {
  font-size: 20rpx;
}

.filter-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: var(--brand-color, #FF6B35);
  border-radius: 28rpx;
  padding: 0 6rpx;
}

.sort-btn,
.reset-btn {
  padding: 8rpx 20rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.reset-btn {
  color: var(--brand-color, #FF6B35);
  background: #FFF3ED;
}

/* 筛选面板 */
.filter-panel {
  background: #fff;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-section {
  margin-bottom: 20rpx;
}

.filter-section:last-child {
  margin-bottom: 0;
}

.filter-section-title {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #F5F5F5;
  transition: all 0.2s;
}

.filter-chip.active {
  background: var(--brand-color, #FF6B35);
  color: #fff;
}

/* 结果数量 */
.result-count {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #999;
}

.count-num {
  color: var(--brand-color, #FF6B35);
  font-weight: 600;
  font-size: 28rpx;
}

/* 活动卡片 */
.activity-list {
  padding: 0 24rpx;
}

.activity-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-category {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: #FFF3ED;
  color: var(--brand-color, #FF6B35);
}

.card-status {
  font-size: 22rpx;
}

.card-status.active {
  color: #52C41A;
}

.card-status.inactive {
  color: #999;
}

.card-status.suspended {
  color: #FAAD14;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.card-suspension {
  display: block;
  font-size: 24rpx;
  color: #AD6800;
  background: #FFF7E6;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.info-text {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

/* 灵活时间标签 */
.card-tags {
  margin-top: 12rpx;
  display: flex;
  gap: 8rpx;
}

.flexible-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  background: #E6F7FF;
  color: #1890FF;
  border-radius: 6rpx;
}

/* 空状态 & 错误状态 */
.empty-state,
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.retry-btn {
  margin-top: 30rpx;
  padding: 16rpx 60rpx;
  background: var(--brand-color, #FF6B35);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}

.retry-btn::after {
  border: none;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top: 4rpx solid var(--brand-color, #FF6B35);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
