/* pages/index/index.wxss — v2 原型（橙主题 + 6 tab + 4 下拉 + 日历周视图） */

.container {
  padding-bottom: 40rpx;
  /* CSS 变量，供日历视图使用 */
  --brand: #667eea;
  --brand2: #764ba2;
  --bg: #F4F6FB;
  --line: #ECEEF4;
}

/* 头部（精简版：仅搜索框） */
.h5header {
  background: #fff;
  padding: 18rpx 28rpx;
  border-bottom: 1rpx solid #F0E6DF;
}
.searchbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  position: relative;
}
.search-input {
  flex: 1;
  border: 3rpx solid #F0E6DF;
  background: #FFF9F5;
  border-radius: 40rpx;
  padding: 16rpx 70rpx 16rpx 30rpx;
  font-size: 26rpx;
  color: #333;
}
.clear-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b3a59c;
}

/* 6 个 Tab（横滑，gap 控制间距） */
.tabs-nav {
  white-space: nowrap;
  background: #fff;
  border-bottom: 1rpx solid #F0E6DF;
  display: flex;
  align-items: stretch;
  padding: 0 16rpx;
  gap: 0;            /* 用 margin-right 而不是 gap，便于最后一个不溢出 */
}
.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  padding: 22rpx 14rpx;
  margin-right: 18rpx; /* tab 之间留间距的关键 */
  font-size: 26rpx;
  font-weight: 500;
  color: #b3a59c;
  border-bottom: 4rpx solid transparent;
  flex-shrink: 0;
  box-sizing: border-box;
}
.tab-item:last-child {
  margin-right: 0;     /* 最后一个 tab 不再加右边距，避免溢出横滑 */
}
.tab-item .ic { font-size: 26rpx; }
.tab-item .cnt { font-size: 20rpx; color: #c9bcb3; }
.tab-item.on { color: #FF6B35; border-bottom-color: #FF6B35; font-weight: 600; }
.tab-item.on .cnt { color: #FF6B35; }

/* 4 个下拉 */
.filters {
  display: flex;
  gap: 14rpx;
  background: #fff;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #F0E6DF;
  flex-wrap: wrap;
  position: relative;
}
.dd-wrap {
  position: relative;
  flex: 1 1 auto;
  min-width: 140rpx;
}
.dd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  padding: 14rpx 22rpx;
  border: 3rpx solid #F0E6DF;
  border-radius: 28rpx;
  background: #FFF9F5;
  font-size: 24rpx;
  color: #6b5f57;
}
.dd.open {
  border-color: #FF6B35;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(255,107,53,.18);
}
.dd .caret {
  font-size: 18rpx;
  color: #c9bcb3;
  transition: transform .18s;
}
.dd.open .caret { transform: rotate(180deg); color: #FF6B35; }
.dd-menu {
  position: absolute;
  top: calc(100% + 10rpx);
  left: 0;
  right: 0;
  background: #fff;
  border: 1rpx solid #F0E6DF;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(120,60,20,.16);
  z-index: 40;
  max-height: 420rpx;
  overflow-y: auto;
  padding: 10rpx;
}
.dd-opt {
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #5b514a;
  border-radius: 16rpx;
}
.dd-opt.on {
  background: linear-gradient(135deg,#FF6B35,#FF8C00);
  color: #fff;
  font-weight: 600;
}

/* 结果计数 */
.result-count {
  padding: 22rpx 28rpx 8rpx;
  font-size: 24rpx;
  color: #9a8f88;
}
.count-num { color: #FF6B35; font-weight: 600; font-size: 28rpx; }

/* 列表卡片 */
.list { padding: 0 28rpx; }
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(120,60,20,.05);
  border-left: 6rpx solid #FF6B35;
}
.card .r1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
}
.badge {
  background: linear-gradient(135deg,#FF6B35,#FF8C00);
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.st { font-size: 20rpx; color: #3B8C2F; }
.st.pause { color: #C0392B; }
.card .tt {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin: 14rpx 0;
}
.info {
  font-size: 24rpx;
  color: #7a6e66;
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-top: 6rpx;
}
.ftag {
  display: inline-block;
  background: #FBEFE6;
  color: #C0561F;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

/* ===== 日历周视图（H5 同款） ===== */
.week-header {
  display: flex;
  gap: 8rpx;
  padding: 14rpx 16rpx 8rpx;
  background: var(--bg);
}
.date-cell-header {
  flex: 1 1 0;
  padding: 8rpx 2rpx;
  background: #fff;
  border: 1.5rpx solid var(--line);
  color: var(--brand);
  border-radius: 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  cursor: pointer;
  min-height: 64rpx;
  justify-content: center;
  box-sizing: border-box;
  transition: transform .15s, box-shadow .15s;
}
.date-cell-header .dn {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.1;
}
.date-cell-header .dw {
  font-size: 18rpx;
  color: #aab0bd;
}
.date-cell-header.today {
  background: linear-gradient(135deg, #FF8C00, #FF6B35);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(255, 140, 0, .35);
}
.date-cell-header.today .dw { color: rgba(255,255,255,.9); }
.date-cell-header.sel {
  background: linear-gradient(135deg, var(--brand), var(--brand2));
  color: #fff;
  border-color: transparent;
  box-shadow: 0 5rpx 14rpx rgba(102, 126, 234, .4);
  transform: translateY(-2rpx);
}
.date-cell-header.sel .dw { color: rgba(255,255,255,.9); }

.week-grid {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 16rpx 18rpx;
  background: var(--bg);
  align-items: stretch;
}
.day-cell {
  flex: 1 1 0;
  background: #fff;
  border: 1.5rpx solid var(--line);
  border-radius: 12rpx;
  padding: 8rpx 4rpx;
  min-height: 360rpx;
  box-sizing: border-box;
  transition: opacity .15s, box-shadow .15s, border-color .15s;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.day-cell.dim { opacity: .22; }
.day-cell.sel {
  border-color: var(--brand);
  background: linear-gradient(180deg, #f3f5ff, #eaf0ff);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, .25);
}
.day-cell.today { border-color: #ffcf80; }
.empty-d {
  font-size: 20rpx;
  color: #cdd2dc;
  text-align: center;
  padding-top: 80rpx;
}
.card-mini {
  background: #fbfbfd;
  border-left: 4rpx solid #ccc;
  border-radius: 8rpx;
  padding: 6rpx 6rpx;
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,.04);
  cursor: pointer;
}
.card-mini-hover {
  background: #FFF3EC;
  transform: translateX(2rpx);
}
.card-mini .at-name {
  display: block;
  font-size: 20rpx;
  color: #1A1A1A;
  font-weight: 500;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-mini .at-time {
  display: block;
  font-size: 16rpx;
  color: #a8aebc;
  margin-top: 2rpx;
  line-height: 1.1;
}
.day-hint {
  margin: 0 16rpx 18rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand2));
  color: #fff;
  border-radius: 12rpx;
  font-size: 22rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.day-clear {
  background: rgba(255,255,255,.2);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 600;
}
.empty-state, .error-state, .loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: #666; margin-bottom: 8rpx; }
.retry-btn {
  margin-top: 30rpx;
  padding: 16rpx 60rpx;
  background: #FF6B35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}
.retry-btn::after { border: none; }

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top: 4rpx solid #FF6B35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 28rpx; color: #999; }