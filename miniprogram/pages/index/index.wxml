<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-wrap">
      <input
        class="search-input"
        placeholder="搜索活动..."
        value="{{keyword}}"
        bindinput="onSearch"
        confirm-type="search"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view
      class="category-tag {{currentCategory === item ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      bindtap="onCategoryTap"
      data-category="{{item}}"
    >
      {{item}}
    </view>
  </scroll-view>

  <!-- 筛选工具栏 -->
  <view class="filter-toolbar">
    <view class="filter-toggle" bindtap="onToggleFilters">
      <text class="filter-icon">🔽</text>
      <text class="filter-label">筛选</text>
      <text class="filter-badge" wx:if="{{activeFilterCount > 0}}">{{activeFilterCount}}</text>
    </view>
    <view class="sort-btn" bindtap="onSortTap">
      <text>{{currentSort === 'default' ? '排序' : (currentSort === 'price-asc' ? '价格↑' : '价格↓')}}</text>
    </view>
    <view class="reset-btn" wx:if="{{activeFilterCount > 0}}" bindtap="onResetFilters">
      <text>重置</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-panel {{showFilters ? 'open' : ''}}" wx:if="{{showFilters}}">
    <!-- 价格筛选 -->
    <view class="filter-section">
      <text class="filter-section-title">价格</text>
      <view class="filter-chips">
        <view
          class="filter-chip {{currentPrice === item ? 'active' : ''}}"
          wx:for="{{priceOptions}}"
          wx:key="*this"
          bindtap="onPriceTap"
          data-price="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <!-- 星期筛选 -->
    <view class="filter-section">
      <text class="filter-section-title">星期</text>
      <view class="filter-chips">
        <view
          class="filter-chip {{currentWeekday === item ? 'active' : ''}}"
          wx:for="{{weekdayOptions}}"
          wx:key="*this"
          bindtap="onWeekdayTap"
          data-weekday="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 活动数量 -->
  <view class="result-count">
    共 <text class="count-num">{{filteredItems.length}}</text> 个活动
  </view>

  <!-- 活动列表 -->
  <view class="activity-list" wx:if="{{filteredItems.length > 0}}">
    <view
      class="activity-card"
      wx:for="{{filteredItems}}"
      wx:key="id"
      bindtap="onCardTap"
      data-id="{{item.id}}"
    >
      <view class="card-header">
        <text class="card-category {{item.category}}">{{item.category}}</text>
        <text class="card-status {{item.status === '进行中' ? 'active' : (item.status === '已暂停' ? 'suspended' : 'inactive')}}">
          {{item.status === '已暂停' ? '已暂停' : item.status}}
        </text>
      </view>
      <text class="card-title">{{item.title}}</text>
      <text class="card-suspension" wx:if="{{item.suspensionNote}}">⚠️ {{item.suspensionNote}}</text>
      <view class="card-info">
        <view class="info-row">
          <text class="icon">📍</text>
          <text class="info-text">{{item.location}}</text>
        </view>
        <view class="info-row">
          <text class="icon">💰</text>
          <text class="info-text">{{item.price || '价格待定'}}</text>
        </view>
        <view class="info-row">
          <text class="icon">🕐</text>
          <text class="info-text">{{item.time || '时间灵活'}}</text>
        </view>
      </view>
      <!-- 灵活时间标签 -->
      <view class="card-tags" wx:if="{{item.flexibleTime === '是'}}">
        <text class="flexible-tag">🕐 灵活时间</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredItems.length === 0 && !loading && !error}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">没有找到相关活动</text>
    <text class="empty-hint">试试调整筛选条件或关键词</text>
    <button class="retry-btn" bindtap="onResetFilters" wx:if="{{activeFilterCount > 0 || keyword}}">清除所有筛选</button>
  </view>

  <!-- 错误状态 -->
  <view class="error-state" wx:if="{{error}}">
    <text class="empty-icon">😔</text>
    <text class="empty-text">加载失败</text>
    <button class="retry-btn" bindtap="onRetry">重新加载</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>
